# Private dashboard (required)
DASHBOARD_ACCESS_CODE=choose-your-access-code
DASHBOARD_SESSION_SECRET=
# Optional: if blank, a random secret is persisted in data/session-secret.key
DASHBOARD_URL=https://your-dashboard-domain.example

# Telegram bot token (optional, free). TELEGRAM_BOT_TOKEN is preferred.
TELEGRAM_BOT_TOKEN=
# Legacy variable remains supported for existing deployments.
BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional KOL expert intelligence. Free MadeOnSol key: https://madeonsol.com/developer
# Free tier documents 200 requests/day; no paid plan required.
MADEONSOL_API_KEY=

# Solana public RPC (optional override; default is https://api.mainnet.solana.com)
SOLANA_RPC_URL=

# Scanner tuning
PORT=8080
NODE_ENV=production
SCAN_INTERVAL_MS=60000
ALERT_MIN_SCORE=78
MIN_LIQUIDITY_USD=5000
