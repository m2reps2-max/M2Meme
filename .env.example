# Private dashboard
DASHBOARD_ACCESS_CODE=change-this-to-a-long-random-code
DASHBOARD_SESSION_SECRET=generate-a-stable-random-secret-at-least-32-bytes
DASHBOARD_URL=https://your-domain.example

# Telegram bot and alert destination
BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Data providers: keys are optional, remain server-side
PUMPPORTAL_API_KEY=
BIRDEYE_API_KEY=
HELIUS_API_KEY=
X_BEARER_TOKEN=

# Scanner tuning
PORT=3000
NODE_ENV=production
SCAN_INTERVAL_MS=60000
ALERT_MIN_SCORE=78
MIN_LIQUIDITY_USD=5000
