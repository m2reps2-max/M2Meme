# Private dashboard (required)
DASHBOARD_ACCESS_CODE=replace-with-a-strong-code-at-least-12-characters
DASHBOARD_SESSION_SECRET=replace-with-a-stable-random-secret-at-least-32-characters
DASHBOARD_URL=https://your-dashboard-domain.example

# Telegram alerts (optional, free)
BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Solana public RPC (optional override; default is https://api.mainnet.solana.com)
SOLANA_RPC_URL=

# Scanner tuning
PORT=3000
NODE_ENV=production
SCAN_INTERVAL_MS=60000
ALERT_MIN_SCORE=78
MIN_LIQUIDITY_USD=5000
